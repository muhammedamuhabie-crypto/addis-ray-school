server {
    listen 80;
    listen [::]:80;

    server_name _;

    client_max_body_size 20M;

    location /static/ {
        alias /opt/addis_ray_school/staticfiles/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /media/ {
        alias /opt/addis_ray_school/media/;
        expires 1d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://unix:/run/addis_ray_school/addis_ray_school.sock;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_redirect off;
    }
}
