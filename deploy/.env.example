# Django
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=YOUR_DOMAIN,YOUR_SERVER_IP

# PostgreSQL
DB_NAME=addis_ray_school_db
DB_USER=addisray
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# HTTPS
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_HSTS_SECONDS=31536000

# Email
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=YOUR_EMAIL_USERNAME
DJANGO_EMAIL_HOST_PASSWORD=YOUR_EMAIL_PASSWORD
DJANGO_DEFAULT_FROM_EMAIL=YOUR_FROM_EMAIL
DJANGO_SERVER_EMAIL=YOUR_SERVER_EMAIL
